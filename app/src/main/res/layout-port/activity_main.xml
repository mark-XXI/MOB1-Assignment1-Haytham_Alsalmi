<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Toast Button -->
    <Button
        android:id="@+id/button_toast"
        android:layout_width="96dp"
        android:minWidth="0dp"
        android:textSize="12sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_height="48dp"
        android:text="@string/toast"
        android:onClick="show_toast"
        android:textColor="@android:color/white"
        android:backgroundTint="#3F51B5"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/text_display_count"
        app:layout_constraintTop_toTopOf="@id/text_display_count"
        app:layout_constraintBottom_toTopOf="@id/button_zero"
        app:layout_constraintVertical_chainStyle="spread_inside"/>

    <!-- Zero Button -->
    <Button
        android:id="@+id/button_zero"
        android:layout_width="96dp"
        android:minWidth="0dp"
        android:textSize="12sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_height="48dp"
        android:text="ZERO"
        android:onClick="show_zero"
        android:textColor="@android:color/white"
        android:backgroundTint="#9E9E9E"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/text_display_count"
        app:layout_constraintTop_toBottomOf="@id/button_toast"
        app:layout_constraintBottom_toTopOf="@id/button_count"/>

    <!-- Count Button -->
    <Button
        android:id="@+id/button_count"
        android:layout_width="96dp"
        android:minWidth="0dp"
        android:textSize="12sp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_height="48dp"
        android:text="@string/count"
        android:onClick="increase_count"
        android:textColor="@android:color/white"
        android:backgroundTint="#0000FF"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/text_display_count"
        app:layout_constraintTop_toBottomOf="@id/button_zero"
        app:layout_constraintBottom_toBottomOf="@id/text_display_count"/>

    <!-- Count Display -->
    <TextView
        android:id="@+id/text_display_count"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#FFEB3B"
        android:gravity="center"
        android:text="@string/count_value"
        android:textColor="#0000FF"
        android:textSize="150sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/button_toast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.52"
        app:layout_constraintVertical_bias="0.0"/>

</androidx.constraintlayout.widget.ConstraintLayout>
